{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Modo Aula",
  "version": "1.2.0",
  "identifier": "br.com.teologiabethel.modoaula",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Modo Aula",
        "width": 1320,
        "height": 840,
        "minWidth": 980,
        "minHeight": 620,
        "center": true,
        "backgroundColor": "#0e1013"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Curso de Teologia Bethel",
    "copyright": "Prof. Thiago de Souza",
    "category": "Education",
    "resources": { "biblia/": "biblia/" },
    "shortDescription": "Modo Aula",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": { "installMode": "currentUser", "languages": ["PortugueseBR"], "displayLanguageSelector": false }
    }
  }
}
